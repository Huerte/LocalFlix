"""Poster pipeline: local image -> embedded art -> internet -> video frame -> nothing."""
from __future__ import annotations

import json
import os
import re
import threading
import time
import urllib.parse
import urllib.request

from .core import IMG_EXTS, cfg, title_key

UA = {"User-Agent": "LocalFlix/2.0 (personal media library)"}


class Posters:
    def __init__(self, lib, media):
        self.lib, self.media = lib, media
        self.dir = os.path.join(cfg.data_dir, "posters")
        self.meta_path = os.path.join(cfg.data_dir, "meta.json")
        os.makedirs(self.dir, exist_ok=True)
        self.meta = {}
        try:
            with open(self.meta_path, "r", encoding="utf-8") as fh:
                self.meta = json.load(fh)
        except (OSError, ValueError):
            pass
        self._lock = threading.Lock()
        self._queue = []
        self._queued = set()
        self._cv = threading.Condition()
        self._net_ok = True
        threading.Thread(target=self._worker, daemon=True).start()

    # ---- public
    def info(self, mid):
        return self.meta.get(mid) or {}

    def path(self, mid):
        for e in ("jpg", "png", "webp"):
            p = os.path.join(self.dir, f"{mid}.{e}")
            if os.path.isfile(p):
                return p
        return None

    def state(self, m):
        i = self.meta.get(m["id"])
        if not i:
            return "pending", 0
        if i.get("kind"):
            return "ready", i.get("ver", 0)
        return "none", 0

    def pending_count(self):
        with self._cv:
            return len(self._queue)

    def schedule(self, movies, refresh=False):
        with self._cv:
            for m in movies:
                i = self.meta.get(m["id"])
                retry = bool(i) and not i.get("online_done") and cfg.get("online_lookup") and \
                    time.time() - i.get("tried", 0) > 6 * 3600 and i.get("kind") in ("frame", None)
                if refresh or not i or retry:
                    if m["id"] not in self._queued:
                        self._queued.add(m["id"])
                        self._queue.append(m)
            self._cv.notify()

    def set_custom(self, mid, data):
        self._save_image(mid, data)
        self._record(mid, {"kind": "custom", "online_done": True, "tried": time.time()})

    # ---- internals
    def _record(self, mid, info):
        with self._lock:
            old = self.meta.get(mid, {})
            old.update(info)
            old["ver"] = int(time.time())
            self.meta[mid] = old
            try:
                tmp = self.meta_path + ".tmp"
                with open(tmp, "w", encoding="utf-8") as fh:
                    json.dump(self.meta, fh)
                os.replace(tmp, self.meta_path)
            except OSError:
                pass

    def _save_image(self, mid, data):
        if not data or len(data) < 500:
            return False
        ext = "jpg"
        if data[:8] == b"\x89PNG\r\n\x1a\n":
            ext = "png"
        elif data[:4] == b"RIFF" and data[8:12] == b"WEBP":
            ext = "webp"
        elif data[:3] != b"\xff\xd8\xff":
            return False
        for e in ("jpg", "png", "webp"):
            try:
                os.unlink(os.path.join(self.dir, f"{mid}.{e}"))
            except OSError:
                pass
        tmp = os.path.join(self.dir, f"{mid}.tmp")
        with open(tmp, "wb") as fh:
            fh.write(data)
        os.replace(tmp, os.path.join(self.dir, f"{mid}.{ext}"))
        return True

    def _worker(self):
        while True:
            with self._cv:
                while not self._queue:
                    self._cv.wait()
                m = self._queue.pop(0)
            try:
                self._process(m)
            except Exception:
                self._record(m["id"], {"kind": None, "tried": time.time()})
            finally:
                with self._cv:
                    self._queued.discard(m["id"])

    def _local_image(self, m):
        d = os.path.dirname(m["full"])
        stem = os.path.splitext(os.path.basename(m["full"]))[0]
        names = [stem, stem + "-poster", stem + ".poster", "poster", "folder", "cover", "movie", "front"]
        for n in names:
            for e in IMG_EXTS:
                p = os.path.join(d, n + e)
                if os.path.isfile(p):
                    return p
        return None

    def _process(self, m):
        mid = m["id"]
        info = {"tried": time.time()}
        kind = None
        probe = self.media.probe(m["full"]) if self.media.ffprobe else None
        dur = probe["duration"] if probe else None
        if dur:
            info["dur"] = dur
        p = self._local_image(m)
        if p:
            try:
                with open(p, "rb") as fh:
                    if self._save_image(mid, fh.read()):
                        kind = "local"
            except OSError:
                pass
        if not kind and probe:
            out = os.path.join(self.dir, f"{mid}.cover.jpg")
            if self.media.extract_cover(m["full"], probe, out):
                with open(out, "rb") as fh:
                    data = fh.read()
                os.unlink(out)
                if self._save_image(mid, data):
                    kind = "embedded"
        online = None
        if cfg.get("online_lookup"):
            online = self._online(m)
            if online is not None:
                info["online_done"] = True
                if online:
                    for k in ("overview", "genre", "year_online"):
                        if online.get(k):
                            info[k] = online[k]
                    if not kind and online.get("poster"):
                        data = self._get(online["poster"], binary=True)
                        if data and self._save_image(mid, data):
                            kind = "online"
        if not kind and self.media.available:
            out = os.path.join(self.dir, f"{mid}.frame.jpg")
            if self.media.grab_frame(m["full"], dur, out):
                with open(out, "rb") as fh:
                    data = fh.read()
                os.unlink(out)
                if self._save_image(mid, data):
                    kind = "frame"
        info["kind"] = kind
        self._record(mid, info)

    # ---- online lookup (no key needed)
    def _get(self, url, binary=False):
        try:
            req = urllib.request.Request(url, headers=UA)
            with urllib.request.urlopen(req, timeout=8) as r:
                data = r.read(8_000_000)
            return data if binary else json.loads(data.decode("utf-8", "replace"))
        except Exception:
            return None

    def _online(self, m):
        """Returns dict (found), {} (searched, nothing), or None (network failure)."""
        time.sleep(0.4)  # be gentle with the free services
        key = cfg.get("tmdb_key")
        if key:
            q = urllib.parse.urlencode({"api_key": key, "query": m["title"], **({"year": m["year"]} if m["year"] else {})})
            data = self._get("https://api.themoviedb.org/3/search/movie?" + q)
            if data is None:
                return None
            for r in (data.get("results") or [])[:5]:
                if r.get("poster_path") and self._same(m, r.get("title", ""), (r.get("release_date") or "")[:4]):
                    return {"poster": "https://image.tmdb.org/t/p/w500" + r["poster_path"], "overview": r.get("overview", ""),
                            "year_online": (r.get("release_date") or "")[:4]}
        q = urllib.parse.urlencode({"term": m["title"], "media": "movie", "entity": "movie", "limit": 8})
        sep = "&" if "?" in cfg.itunes_url else "?"
        data = self._get(cfg.itunes_url + sep + q)
        if data is None:
            return None
        for r in data.get("results") or []:
            if self._same(m, r.get("trackName", ""), (r.get("releaseDate") or "")[:4]):
                art = r.get("artworkUrl100") or ""
                art = re.sub(r"/\d+x\d+(bb)?\.(jpg|png)$", r"/600x900bb.\2", art)
                return {"poster": art, "overview": r.get("longDescription") or r.get("shortDescription") or "",
                        "genre": r.get("primaryGenreName", ""), "year_online": (r.get("releaseDate") or "")[:4]}
        return {}

    @staticmethod
    def _same(m, name, year):
        a, b = set(title_key(m["title"])), set(title_key(re.sub(r"\(.*?\)", "", name)))
        if not a or not b:
            return False
        if {t for t in a if t.isdigit()} != {t for t in b if t.isdigit()}:
            return False
        if m["year"] and year and abs(int(year) - m["year"]) > 1:
            return False
        return a == b or (len(a & b) / len(a | b) >= 0.8)
