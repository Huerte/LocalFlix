cfg = Config()


# --------------------------------------------------------------------------- naming
JUNK = re.compile(
    r"^(2160p|1080p|1080i|720p|480p|360p|4k|uhd|hdr|hdr10|dv|bluray|blu|ray|brrip|bdrip|webrip|web|webdl|hdrip|dvdrip|dvd|"
