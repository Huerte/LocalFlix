<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Needed for automatic server discovery (UDP broadcast, see Discovery.kt) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Declare this is a TV app -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- usesCleartextTraffic="true": Android 9+ blocks plain http:// by default, and the LocalFlix
         server on your laptop speaks http://. Without this you would see "Cannot reach server". -->
    <application
        android:allowBackup="true"
        android:banner="@drawable/ic_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.LocalFlix"
        android:usesCleartextTraffic="true">

        <!-- The whole UI: WebView with the LocalFlix web page + native connect screen -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- TV launcher icon -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Native ExoPlayer screen, opened from the web page through window.LocalFlixTV.play() -->
        <activity
            android:name=".PlayerActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="landscape" />

    </application>

</manifest>
