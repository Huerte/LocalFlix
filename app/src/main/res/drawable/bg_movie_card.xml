<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused via D-pad: amber border + lighter background -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_focused" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/border_focused" />
        </shape>
    </item>

    <!-- Pressed (touch) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_focused" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/amber" />
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/border" />
        </shape>
    </item>

</selector>
