<?xml version="1.0" encoding="utf-8"?>
<!--
  Native player screen. Laid out like the web player (static/player.js + app.css .player):
    top    : back button + title + "year · resolution · format"
    bottom : seek bar, then [-10 | play/pause | +10] cluster, time, ... Next, Subtitles, Audio, Settings
  All controls sit inside a TV safe area (56dp sides, 36dp top/bottom) because many TVs crop the screen edges.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Video + (direct mode) subtitles. No built-in controller: the controls below are ours. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:use_controller="false" />

    <!-- Subtitles when the stream is converted (transcode mode) -->
    <TextView
        android:id="@+id/subText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="96dp"
        android:layout_marginEnd="96dp"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:shadowColor="#000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="6"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/spinner"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Shown while paused, like the web player's big play button -->
    <ImageView
        android:id="@+id/bigPlay"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_big_play"
        android:contentDescription="Play"
        android:padding="26dp"
        android:src="@drawable/ic_play"
        android:visibility="gone" />

    <!-- Controls -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- top: back + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_grad_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingTop="32dp"
            android:paddingEnd="56dp"
            android:paddingBottom="28dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_pbtn"
                android:contentDescription="Back to library"
                android:nextFocusDown="@+id/seekBar"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#99FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- bottom: seek bar + buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_grad_bottom"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingTop="56dp"
            android:paddingEnd="56dp"
            android:paddingBottom="32dp">

            <!-- Focusable seek bar: Left/Right seek while it has focus -->
            <FrameLayout
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/bg_seek"
                android:focusable="true"
                android:nextFocusUp="@id/btnBack"
                android:nextFocusDown="@+id/bPlay"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ProgressBar
                    android:id="@+id/seekProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_gravity="center_vertical"
                    android:indeterminate="false"
                    android:max="1000"
                    android:progressDrawable="@drawable/progress_seek" />

                <View
                    android:id="@+id/seekThumb"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_thumb"
                    android:visibility="invisible" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- left cluster: -10 / play / +10 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cluster"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <ImageButton
                        android:id="@+id/bBack10"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_pbtn"
                        android:contentDescription="Back 10 seconds"
                        android:nextFocusUp="@id/seekBar"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_b10" />

                    <ImageButton
                        android:id="@+id/bPlay"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_pbtn_play"
                        android:contentDescription="Pause"
                        android:nextFocusUp="@id/seekBar"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_pause" />

                    <ImageButton
                        android:id="@+id/bFwd10"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_pbtn"
                        android:contentDescription="Forward 10 seconds"
                        android:nextFocusUp="@id/seekBar"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_f10" />
                </LinearLayout>

                <TextView
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textColor="#BFFFFFFF"
                    android:textSize="17sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/bNext"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pbtn"
                    android:contentDescription="Next episode"
                    android:nextFocusUp="@id/seekBar"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_next"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/bSubs"
                    style="@style/PlayerPill"
                    android:drawableStart="@drawable/ic_cc"
                    android:nextFocusUp="@id/seekBar"
                    android:text="Subtitles" />

                <Button
                    android:id="@+id/bAudio"
                    style="@style/PlayerPill"
                    android:drawableStart="@drawable/ic_audio"
                    android:nextFocusUp="@id/seekBar"
                    android:text="Audio" />

                <ImageButton
                    android:id="@+id/bSet"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_pbtn"
                    android:contentDescription="Playback settings"
                    android:nextFocusUp="@id/seekBar"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sliders" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Short status message, e.g. "Converting for this TV..." -->
    <TextView
        android:id="@+id/msgText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_panel"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- Subtitle / audio / settings panel: header (back, title, close), divider, scrolling list -->
    <LinearLayout
        android:id="@+id/menuPanel"
        android:layout_width="460dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="112dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/menuTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="6dp"
            android:background="#1AFFFFFF" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="290dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/menuList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- Next-episode prompt and error messages -->
    <LinearLayout
        android:id="@+id/dialogPanel"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text"
            android:textSize="19sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/dialogBtnA"
                style="@style/PlayerBtn"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/dialogBtnB"
                style="@style/PlayerBtn"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
