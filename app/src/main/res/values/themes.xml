<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Theme.AppCompat.Leanback is defined in the leanback artifact.
        We also inherit AppCompat attrs (colorPrimary, colorAccent, colorPrimaryDark)
        so they must be declared with the AppCompat namespace (no "android:" prefix).
    -->
    <style name="Theme.LocalFlix" parent="@style/Theme.AppCompat.Leanback">
        <!-- Window -->
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/muted</item>

        <!-- AppCompat color attrs — no android: prefix -->
        <item name="colorPrimary">@color/surface</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/amber</item>
    </style>
</resources>
