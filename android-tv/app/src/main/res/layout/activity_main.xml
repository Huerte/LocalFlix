<?xml version="1.0" encoding="utf-8"?>
<!-- The whole app is one WebView (added in code, inside webHolder) plus a native "connect" panel. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/webHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Shown while connecting, when the server is missing, or from Menu / Settings > Change TV server -->
    <LinearLayout
        android:id="@+id/connectPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LocalFlix"
            android:textColor="@color/accent"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connStatus"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <ProgressBar
            android:id="@+id/connProgress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <EditText
            android:id="@+id/connInput"
            android:layout_width="460dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input"
            android:hint="http://192.168.1.10:8080"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="20sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/connRetry"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn"
                android:minWidth="160dp"
                android:stateListAnimator="@null"
                android:text="Retry"
                android:textAllCaps="false"
                android:textColor="@color/btn_text"
                android:textSize="20sp" />

            <Button
                android:id="@+id/connConnect"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_btn"
                android:minWidth="160dp"
                android:stateListAnimator="@null"
                android:text="Connect"
                android:textAllCaps="false"
                android:textColor="@color/btn_text"
                android:textSize="20sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Tip: press the Menu key on the remote at any time to change the server."
            android:textColor="@color/muted"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
