<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_movie_card"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:padding="0dp"
    android:layout_margin="6dp">

    <!-- Thumbnail area with play icon -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0"
        android:minHeight="110dp">

        <!-- Dark gradient background simulating a poster -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_thumb" />

        <!-- Play icon centered -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="▶"
            android:textSize="28sp"
            android:textColor="#55FFFFFF"
            android:id="@+id/playIcon" />

        <!-- Format badge top-right -->
        <TextView
            android:id="@+id/movieMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:textColor="@color/amber"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_ext_badge"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

    </FrameLayout>

    <!-- Movie info bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/movieName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2" />

        <TextView
            android:id="@+id/movieFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/indigo"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>
